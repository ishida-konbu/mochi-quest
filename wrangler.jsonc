{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mochi-quest",
  "main": "./worker.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/music/*", "!/audio/music/available.json"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
